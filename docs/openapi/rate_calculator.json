        "required": [
          "correlation_id",
          "final_rate",
          "credit_tier",
          "district",
          "base_rate",
          "term_multiplier",
          "credit_tier_multiplier",
          "regional_risk_multiplier",
          "calculated_at"
        ],
        "title": "CalculateRateResponse"
      },
