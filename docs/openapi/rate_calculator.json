            "title": "Correlation Id"
          },
          "final_rate": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Final Rate"
          },
          "credit_tier": {
            "type": "string",
            "title": "Credit Tier"
          },
          "district": {
            "type": "string",
